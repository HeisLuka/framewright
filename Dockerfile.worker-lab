FROM node:20.20.2-bookworm-slim@sha256:672e756543d555ea2f8bb66e265d9848febce2e05f10bde577b9e55ce1a7a356

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    PUPPETEER_CACHE_DIR=/home/node/.cache/puppeteer \
    CONTAINER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

WORKDIR /app
RUN mkdir -p /home/node/.cache/puppeteer \
    && chown -R node:node /home/node/.cache /app
COPY --chown=node:node package.json package-lock.json ./
USER node
RUN npm ci --no-audit --no-fund

COPY --chown=node:node . .

CMD ["node", ".agents/skills/framewright/scripts/worker-manifest.mjs", "/tmp/worker-manifest.json"]
