{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newboo.dev/contracts/catalog-creative-source-v1.schema.json",
  "title": "NEwBOO CatalogCreativeSource v1",
  "type": "object",
  "required": ["schema", "source_id", "source_hash", "revision", "locale", "policies", "book"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "newboo-catalog-creative-source-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "locale": {"type": "string", "minLength": 1},
    "policies": {
      "type": "object",
      "required": ["structured_spoiler_level", "description_spoiler_level", "release_note_spoiler_level"],
      "additionalProperties": false,
      "properties": {
        "structured_spoiler_level": {"type": "integer", "minimum": 0},
        "description_spoiler_level": {"type": "integer", "minimum": 0},
        "release_note_spoiler_level": {"type": "integer", "minimum": 0}
      }
    },
    "book": {
      "type": "object",
      "required": ["book_id", "title", "author_name", "description"],
      "additionalProperties": false,
      "properties": {
        "book_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "author_name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "subtitle": {"type": "string"},
        "original_title": {"type": "string"},
        "language_original": {"type": "string"},
        "language_translation": {"type": "string"},
        "year": {"type": ["integer", "null"], "minimum": 0},
        "catalog_section": {"type": "string"},
        "alt_titles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "genres": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fandoms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "age_rating": {"type": "string"},
        "status_label": {"type": "string"},
        "total_chapters": {"type": ["integer", "null"], "minimum": 0},
        "release_note": {"type": "string"}
      }
    },
    "verified_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/VerifiedArtifact"}
    }
  },
  "$defs": {
    "VerifiedArtifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_hash", "fact_kind", "fact_value", "spoiler_level", "forms"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fact_kind": {"type": "string", "minLength": 1},
        "fact_value": {"type": "string", "minLength": 1},
        "spoiler_level": {"type": "integer", "minimum": 0},
        "composition_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["surface_type", "text"],
            "additionalProperties": false,
            "properties": {
              "surface_type": {"enum": ["sentence", "clause", "fragment", "question_body", "noun_phrase"]},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
