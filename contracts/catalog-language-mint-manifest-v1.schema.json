{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newboo.dev/contracts/catalog-language-mint-manifest-v1.schema.json",
  "title": "NEwBOO CatalogLanguageMintManifest v1",
  "type": "object",
  "required": ["schema", "manifest_id", "source_id", "source_hash", "book_id", "context_pack_id", "context_hash", "copy_language_id", "copy_language_hash", "provenance_entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "newboo-catalog-language-mint-manifest-v1"},
    "manifest_id": {"type": "string", "pattern": "^nbmint1_[a-f0-9]{64}$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "book_id": {"type": "string", "minLength": 1},
    "context_pack_id": {"type": "string", "minLength": 1},
    "context_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "copy_language_id": {"type": "string", "minLength": 1},
    "copy_language_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "form_ids", "kind", "provenance"],
        "additionalProperties": false,
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "form_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "kind": {"type": "string", "minLength": 1},
          "provenance": {"oneOf": [
            {"$ref": "#/$defs/ExactField"},
            {"$ref": "#/$defs/ExactSpan"},
            {"$ref": "#/$defs/DeterministicTransform"},
            {"$ref": "#/$defs/VerifiedArtifact"}
          ]}
        }
      }
    }
  },
  "$defs": {
    "ExactField": {
      "type": "object",
      "required": ["kind", "source_pointer", "source_hash"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "exact_field"},
        "source_pointer": {"type": "string", "pattern": "^/book/"},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "ExactSpan": {
      "type": "object",
      "required": ["kind", "source_pointer", "source_hash", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "exact_span"},
        "source_pointer": {"const": "/book/description"},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "DeterministicTransform": {
      "type": "object",
      "required": ["kind", "source_pointer", "source_hash", "transform"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "deterministic_transform"},
        "source_pointer": {"type": "string", "pattern": "^/book/"},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "transform": {"const": "number_to_decimal_string_v1"}
      }
    },
    "VerifiedArtifact": {
      "type": "object",
      "required": ["kind", "artifact_id", "artifact_hash"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "verified_artifact"},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
