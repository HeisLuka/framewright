{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newboo.dev/contracts/context-pack-v1.schema.json",
  "title": "NEwBOO ContextPack v1",
  "type": "object",
  "required": ["schema", "context_pack_id", "context_hash", "revision", "account", "books", "ctas", "capabilities", "constraints"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "newboo-context-pack-v1" },
    "context_pack_id": { "type": "string", "minLength": 1 },
    "context_hash": { "$ref": "#/$defs/Sha256" },
    "revision": { "type": "integer", "minimum": 1 },
    "account": { "$ref": "#/$defs/Account" },
    "books": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Book" } },
    "ctas": { "type": "array", "items": { "$ref": "#/$defs/Cta" } },
    "capabilities": { "$ref": "#/$defs/Capabilities" },
    "constraints": { "$ref": "#/$defs/Constraints" }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Account": {
      "type": "object",
      "required": ["account_id"],
      "additionalProperties": false,
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "brand_name": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 }
      }
    },
    "Fact": {
      "type": "object",
      "required": ["fact_id", "kind", "value", "source_ref"],
      "additionalProperties": false,
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "CreativeAtom": {
      "type": "object",
      "required": ["atom_id", "role", "angle_types", "text", "source_fact_ids", "spoiler_level"],
      "additionalProperties": false,
      "properties": {
        "atom_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["hook", "tension", "payoff"] },
        "angle_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["premise", "conflict", "identity", "emotion", "question", "world", "character", "thesis", "quote", "recommendation_context"] }
        },
        "text": { "type": "string", "minLength": 1 },
        "source_fact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "spoiler_level": { "type": "integer", "minimum": 0 }
      }
    },
    "Asset": {
      "type": "object",
      "required": ["asset_id", "role", "sha256"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "Book": {
      "type": "object",
      "required": ["book_id", "title", "author", "facts", "creative_atoms", "assets"],
      "additionalProperties": false,
      "properties": {
        "book_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Fact" } },
        "creative_atoms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CreativeAtom" } },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Asset" } }
      }
    },
    "Cta": {
      "type": "object",
      "required": ["cta_id", "text", "treatments"],
      "additionalProperties": false,
      "properties": {
        "cta_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "treatments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["intent", "direct"] } }
      }
    },
    "Capabilities": {
      "type": "object",
      "required": ["angle_types", "visual_systems", "duration_seconds", "fps", "reveal_timings", "cta_treatments", "delivery_profiles"],
      "additionalProperties": false,
      "properties": {
        "angle_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["premise", "conflict", "identity", "emotion", "question", "world", "character", "thesis", "quote", "recommendation_context"] }
        },
        "visual_systems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "duration_seconds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": [3, 5, 7, 9, 12, 15] } },
        "fps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "reveal_timings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["none", "early", "mid", "late"] } },
        "cta_treatments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["none", "soft_reveal", "intent", "direct", "qr_slot"] } },
        "delivery_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "Constraints": {
      "type": "object",
      "required": ["max_spoiler_level", "max_body_atoms"],
      "additionalProperties": false,
      "properties": {
        "max_spoiler_level": { "type": "integer", "minimum": 0 },
        "max_body_atoms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
