{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newboo.example/contracts/creative-approval-v1.schema.json",
  "title": "Newboo Creative Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "approval_id",
    "draft_id",
    "program_id",
    "copy_manifest_sha256",
    "decision",
    "review_policy_version",
    "issuer_id"
  ],
  "properties": {
    "schema": { "const": "newboo-creative-approval-v1" },
    "authority": { "const": "server_owned" },
    "approval_id": { "type": "string", "pattern": "^nba1_[a-f0-9]{64}$" },
    "draft_id": { "type": "string", "pattern": "^nbd1_[a-f0-9]{64}$" },
    "program_id": { "type": "string", "pattern": "^nbxprog1_[a-f0-9]{64}$" },
    "copy_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["approved", "rejected"] },
    "review_policy_version": { "type": "string", "minLength": 1 },
    "issuer_id": { "type": "string", "minLength": 1 }
  }
}
