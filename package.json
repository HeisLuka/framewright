{
  "name": "framewright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Procedural one-file videos made by coding agents: brief, concepts, storyboard, scenes, render, sound.",
  "repository": "github:smwbev/framewright",
  "license": "MIT",
  "scripts": {
    "doctor": "bash .agents/skills/framewright/scripts/doctor.sh",
    "init": "bash .agents/skills/framewright/scripts/init.sh",
    "shot": "node scripts/look.mjs shot",
    "sheet": "node scripts/look.mjs sheet",
    "info": "node scripts/look.mjs info",
    "audio": "node audio.mjs track.wav",
    "render": "node scripts/render.mjs frames 7 1920 5",
    "render:raw": "node .agents/skills/framewright/scripts/render-raw.mjs out.mp4 7 1920 5",
    "render:webcodecs": "node .agents/skills/framewright/scripts/render-webcodecs.mjs out.mp4 7 1080",
    "bench:render": "node .agents/skills/framewright/scripts/bench-render.mjs",
    "build": "bash scripts/build.sh out.mp4",
    "make": "bash scripts/make.sh",
    "book-ad": "node .agents/skills/framewright/scripts/book-ad.mjs",
    "book-ad:fast": "node .agents/skills/framewright/scripts/book-ad-fast.mjs",
    "test": "node --test test/*.test.mjs",
    "example": "HTML=examples/ris-tv/index.html node .agents/skills/framewright/scripts/look.mjs sheet 24 480 7 shots/example-sheet.png"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "puppeteer": "^23.11.1"
  }
}
